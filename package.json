{
  "name": "breakra",
  "version": "0.1.0",
  "private": true,
  "description": "Compare two OpenAPI 3.0 contracts and return evidence-backed compatibility findings.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome format --write src tests scripts",
    "test": "vitest run",
    "build": "bun scripts/build.ts",
    "smoke": "bun scripts/smoke.ts",
    "oracle": "bun scripts/oracle.ts",
    "bench": "bun scripts/bench.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run smoke"
  },
  "dependencies": {
    "api-smart-diff": "1.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

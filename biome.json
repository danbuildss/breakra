{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "examples/**",
      "!tests/fixtures/**",
      "!examples/*.json"
    ]
  },
  "overrides": [
    {
      "includes": [
        "tests/**",
        "scripts/bench.ts",
        "scripts/lib/**",
        "scripts/verify-live.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
